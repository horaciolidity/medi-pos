# Entorno
NODE_ENV=development

# Base de datos Supabase (PostgreSQL)
# DATABASE_URL: URL del Connection Pooler de Supabase (puerto 6543 para la aplicación en producción/desarrollo)
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-sa-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# DIRECT_URL: URL de conexión directa a Supabase (puerto 5432 para migraciones y prisma db push)
DIRECT_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres"

# Secretos de Autenticación
JWT_SECRET="super-secreto-clinic-pos-argentina-2026-clave-firmada-jwt"

# Superadmin Inicial
SUPERADMIN_EMAIL="superadmin@clinicpos.ar"
SUPERADMIN_PASSWORD="SuperAdmin2026!"

# Integraciones de Pago (Opcionales / Pendiente de credenciales)
MERCADOPAGO_ACCESS_TOKEN=""
MERCADOPAGO_PUBLIC_KEY=""

# Integración Fiscal ARCA / AFIP (Opcionales / Pendiente de certificados)
ARCA_CUIT=""
ARCA_CERT_PATH=""
ARCA_KEY_PATH=""
ARCA_ENVIRONMENT="testing"
