# ============================================================
# VARIABLES DE ENTORNO - CLINIC POS SAAS
# Copiar este archivo como .env y completar los valores reales
# ============================================================

NODE_ENV=development

# ============================================================
# BASE DE DATOS SUPABASE (PostgreSQL)
# Obtener en: Supabase → Settings → Database
# ============================================================

# Connection Pooler (puerto 6543) - para la app en producción
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-sa-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connect_timeout=15"

# Conexión directa (puerto 5432) - para prisma db push / migraciones
DIRECT_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres"

# ============================================================
# JWT Y SEGURIDAD
# ============================================================
JWT_SECRET="cambiar-por-una-clave-aleatoria-de-al-menos-32-caracteres"

# ============================================================
# SUPERADMIN POR DEFECTO (se auto-crea al hacer login por primera vez)
# ============================================================
SUPERADMIN_EMAIL="superadmin@clinicpos.ar"
SUPERADMIN_PASSWORD="SuperAdmin2026!"

# ============================================================
# SUPABASE API KEYS (para referencia / uso futuro con Supabase Auth)
# Obtener en: Supabase → Project Settings → API
# ============================================================
SUPABASE_URL="https://[PROJECT-REF].supabase.co"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."
SUPABASE_SECRET_KEY="sb_secret_..."
SUPABASE_JWKS_URL="https://[PROJECT-REF].supabase.co/auth/v1/.well-known/jwks.json"
